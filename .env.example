# Copy to .env (gitignored) and fill in. Never commit real values.
# Where each secret lives in production: docs/security.md section 4.

# ---------- Local databases (docker-compose.yml) ----------
POSTGRES_USER=depguard
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=depguard
POSTGRES_PORT=5432
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ---------- API ----------
# Local default points at the compose Postgres; production uses the Supabase depguard_api role.
DATABASE_URL=postgresql://depguard:change-me-local@localhost:5432/depguard
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# At least 8 characters (Neo4j rule).
NEO4J_PASSWORD=change-me-local-neo4j
SUPABASE_URL=
SUPABASE_JWKS_URL=
GITHUB_READ_TOKEN=
GITHUB_DISPATCH_TOKEN=
GITHUB_APP_ID=
LLM_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
WEB_ORIGIN=http://localhost:3000
# true only on your machine: turns on POST /v1/ingest, which has no auth yet.
ENABLE_DEV_ENDPOINTS=false
