# Copy to .env (gitignored) and fill in. Never commit real values.
# Where each secret lives in production: docs/security.md section 4.

# ---------- Local databases (docker-compose.yml) ----------
POSTGRES_USER=depguard
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=depguard
POSTGRES_PORT=5432
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ---------- Postgres roles (architecture §5.3) ----------
# 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first, which Docker doesn't listen on,
# and each connection then waits for that attempt to time out.
# The table owner: migrations and role setup only (`make migrate`). Locally, the compose user.
MIGRATION_DATABASE_URL=postgresql://depguard:change-me-local@127.0.0.1:5432/depguard
# The API's role. `make migrate` sets the role's password to the one in this URL.
DATABASE_URL=postgresql://depguard_api:change-me-api@127.0.0.1:5432/depguard
# The daily refresh's role (`make refresh`). Same: its password is set from this URL.
REFRESH_DATABASE_URL=postgresql://depguard_refresh:change-me-refresh@127.0.0.1:5432/depguard

# ---------- API ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# At least 8 characters (Neo4j rule).
NEO4J_PASSWORD=change-me-local-neo4j
# AuraDB Free limits; graph writes stop at 90% of either. Confirm them in the Aura console.
GRAPH_MAX_NODES=200000
GRAPH_MAX_RELATIONSHIPS=400000
SUPABASE_URL=
SUPABASE_JWKS_URL=
GITHUB_READ_TOKEN=
GITHUB_DISPATCH_TOKEN=
GITHUB_APP_ID=
LLM_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
WEB_ORIGIN=http://localhost:3000
# true only on your machine: turns on POST /v1/ingest, which has no auth yet.
ENABLE_DEV_ENDPOINTS=false
